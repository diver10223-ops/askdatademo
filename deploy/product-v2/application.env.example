# Copy to a protected environment file outside the release directory.
# Replace every REQUIRED value before starting a non-demo environment.
ASKDATA_PLATFORM_PORT=8080
ASKDATA_EXECUTION_BASE_URL=http://127.0.0.1:8000
ASKDATA_INTERNAL_SERVICE_TOKEN=REQUIRED_GENERATE_AT_LEAST_32_RANDOM_BYTES
ASKDATA_PLATFORM_API_TOKEN=REQUIRED_GENERATE_SEPARATE_32_RANDOM_BYTES

# Product baseline example. Replace with the approved customer database in M8.
ASKDATA_PLATFORM_DB_URL=jdbc:postgresql://db.example.invalid:5432/askdata
ASKDATA_PLATFORM_DB_USERNAME=askdata_app
ASKDATA_PLATFORM_DB_PASSWORD=REQUIRED_FROM_SECRET_MANAGER
ASKDATA_MIGRATION_DB_URL=jdbc:postgresql://db.example.invalid:5432/askdata
ASKDATA_MIGRATION_DB_USERNAME=askdata_migrator
ASKDATA_MIGRATION_DB_PASSWORD=REQUIRED_FROM_SECRET_MANAGER
ASKDATA_PLATFORM_DB_POOL_MAX=30

ASKDATA_SEED_ENABLED=false
ASKDATA_SEED_DIRECTORY=./fixtures
ASKDATA_EXECUTION_MAX_CONCURRENCY=30
ASKDATA_EXECUTION_PER_USER_CONCURRENCY=2
ASKDATA_EXECUTION_QUEUE_CAPACITY=50
ASKDATA_EXECUTION_MAX_QUEUE_WAIT_MS=5000
ASKDATA_EXECUTION_RECONCILE_DELAY_MS=1000
ASKDATA_SSE_ASYNC_TIMEOUT_MS=3600000
ASKDATA_TOMCAT_ACCEPT_COUNT=2000
ASKDATA_TOMCAT_MAX_CONNECTIONS=5000
ASKDATA_ALERT_ADAPTER=logging
ASKDATA_ALERT_EVALUATION_DELAY_MS=30000

# Python execution-plane data directory. Use a dedicated, backed-up path.
ASKDATA_DATA_DIR=/var/lib/askdata/execution

# Provider credentials are deliberately absent. Configure approved secret
# references and customer adapters during M8; never put real values in Git.
